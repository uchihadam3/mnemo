{
  "name": "mnemo",
  "productName": "MNEMO",
  "version": "1.5.0",
  "description": "MNEMO — o roguelike da memória",
  "main": "electron/main.js",
  "author": "MNEMO",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "web": "npx http-server -p 8080 -c-1 .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win-linux": "bash build/win.sh"
  },
  "build": {
    "appId": "io.github.mnemo.game",
    "productName": "MNEMO",
    "artifactName": "MNEMO-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "manifest.webmanifest",
      "css/**",
      "js/**",
      "fonts/**",
      "assets/**",
      "audio/**",
      "electron/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "MNEMO-${version}-portatil.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MNEMO",
      "artifactName": "MNEMO-${version}-Instalador.${ext}",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "assets/icon.png",
      "maintainer": "MNEMO"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.card-games",
      "icon": "assets/icon.png"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "pe-library": "^2.0.3",
    "resedit": "^2.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uchihadam3/mnemo.git"
  },
  "homepage": "https://uchihadam3.github.io/mnemo/"
}